    "obs": {
        "name": "src_OBS",
        "dir": "/work/PyGLDA_v2_external_data/GRACE/obs",
        "GRACE": {
            "EWH_grid_dir": "/work/PyGLDA_v2_external_data/GRACE/SaGEA/signal_Mascon",
