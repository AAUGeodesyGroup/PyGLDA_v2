        "obs_error_inflation": {},
        "obs_error_correlation": "diagonal",
        "obs_perturbation_centering": true,
        "soil_upper_bound": true,
        "snow_bounds": {
            "lower_factor": 0.5,
            "upper_factor": 2.0,
            "upper_offset_mm": 20.0,
            "envelope_factor": 1.5,
            "envelope_offset_mm": 10.0
