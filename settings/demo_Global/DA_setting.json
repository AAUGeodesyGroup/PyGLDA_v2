        "DA_output_temp_dir": "/work/PyGLDA_v2_external_data/DA_output",
        "Ensemble_ini_dir": "/work/PyGLDA_v2_external_data/Ensemble_Initialization",
        "Ensemble_input_dir": "/work/PyGLDA_v2_external_data/Ensemble_input",
        "Auxiliary_dir": "/work/PyGLDA_v2_external_data/Auxiliary"
