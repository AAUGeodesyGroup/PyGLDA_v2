 @njit(cache=True)
+def _limit_ratio(petgwr_max, petgwr):
+    """
+    Share of the outgoing fluxes (open-water evaporation, point recharge, net abstraction) that the storage can
+    still supply when they exceed petgwr_max (PyGLDA guard, DA review 246).
+
+    In a free model run the storage never lies below its floor (-max_storage for lakes, 0 for wetlands), so
+    petgwr_max >= 0 and petgwr > petgwr_max >= 0 whenever this is called: the ratio is petgwr_max / petgwr in
+    [0, 1), exactly as before. After a data-assimilation write-back the storage can sit a round-off below the
+    floor; then petgwr_max < 0 and, with the area at zero, petgwr = 0, and the plain ratio is 0 / 0
+    (ZeroDivisionError in numba) or negative (negative evaporation / recharge). Here: 0 if petgwr <= 0, and the
+    ratio clipped to [0, 1]. The storage itself is set to the floor by the caller, as before.
+    """
+    if petgwr <= 0.0:
+        return 0.0
+    r = petgwr_max / petgwr
+    if r < 0.0:
+        return 0.0
+    if r > 1.0:
+        return 1.0
+    return r
+
